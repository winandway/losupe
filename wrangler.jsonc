{
  // Configuración para desarrollo local (next dev / wrangler dev) y para empaquetar el worker.
  // En YaDominios Cloud los bindings DB, BUCKET y ASSETS los inyecta la plataforma;
  // lo que se publica de configuración es yadominios.json.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "losupe",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "losupe",
      "database_id": "00000000-0000-4000-8000-000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "losupe-media",
    },
  ],
  "triggers": {
    // Cada 2 horas entre las 11:00 y las 23:00 UTC (7 am–7 pm hora del este): una nota por corrida,
    // repartidas a lo largo del día hasta completar el cupo diario (settings.notes_per_day).
    "crons": ["0 11-23/2 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
