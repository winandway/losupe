{
  // Configuración para desarrollo local (next dev / wrangler dev) y para empaquetar el worker.
  // En YaDominios Cloud los bindings DB, BUCKET y ASSETS los inyecta la plataforma;
  // lo que se publica de configuración es yadominios.json.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "losupe",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "losupe",
      "database_id": "00000000-0000-4000-8000-000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "losupe-media",
    },
  ],
  // Escribir una nota gasta CPU de verdad: dos idiomas, limpieza de HTML, indice anticopia y, si
  // el borrador no pasa, otra vuelta entera. Con el presupuesto por defecto (30 s de CPU) el worker
  // moria a media escritura y la corrida quedaba «en marcha» para siempre — pasó dos veces el 24
  // ago 2026. Este limite es de CPU, no de reloj: esperar a Gemini no consume nada de aqui.
  "limits": {
    "cpu_ms": 300000,
  },
  "triggers": {
    // Las tres franjas de publicacion (ver src/lib/robot/franjas.ts), en UTC. El cron no entiende de
    // horario de verano, asi que se disparan las dos horas posibles de cada franja: en verano manda
    // la primera, en invierno la segunda. No hay riesgo de nota doble porque el turno se apunta por
    // franja y dia local, y el segundo disparo encuentra la marca ya puesta.
    //   7:00 ET -> 11:00 UTC (verano) / 12:00 UTC (invierno)
    //  12:00 ET -> 16:00 UTC          / 17:00 UTC
    //  17:00 ET -> 21:00 UTC          / 22:00 UTC
    "crons": ["0 11,12,16,17,21,22,1,2 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
