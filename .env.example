# Copia este archivo a .env.local (nunca se commitea). Solo nombres; los valores se ponen en
# YaDominios Cloud → tarjeta del sitio → Variables de entorno.

# URL pública del sitio (opcional: si falta, se deduce del dominio de cada petición).
NEXT_PUBLIC_SITE_URL=

# Clave para disparar el robot a mano: GET /__scheduled?key=<CRON_SECRET>. Opcional.
CRON_SECRET=

# ── Robot redactor (bloque 2) ─────────────────────────────────────────────────────────────
# Gemini (texto, cuenta PREPAGO). Sin esta llave el robot no redacta y lo dice en /__health y en el panel.
GEMINI_API_KEY=
# fal.ai (imágenes Seedream 4, $0.03 c/u, cuenta PREPAGO). Opcional si hay Pexels.
FAL_KEY=
# Pexels (fotos gratis con crédito). Opcional si hay fal.ai.
PEXELS_API_KEY=
# Brave Search (opcional: busca noticias además de los RSS).
BRAVE_API_KEY=

# ── Panel de administración (/panel) ─────────────────────────────────────────────────────
# Contraseña de entrada al panel (larga, única). Sin ella el panel no deja entrar a nadie.
ADMIN_PASSWORD=
# Cloudflare Turnstile (escudo anti-robots del login). Opcionales: sin ellas el login funciona igual.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Avisos por correo (bloque 4) ─────────────────────────────────────────────────────────
# Envío transaccional de YaDominios Cloud, incluido en el plan del sitio. No hace falta SMTP.
YAD_SITE=losupe
# Token del sitio: YaDominios Cloud → tarjeta del sitio → «Ver token» (se muestra una sola vez).
YAD_TOKEN=
# Remitente: debe ser de un dominio conectado al sitio.
MAIL_FROM=avisos@losupe.com
MAIL_FROM_NAME=losupe

# ── Redes sociales (bloque 5) ────────────────────────────────────────────────────────────
# Cada nota se anuncia sola en las redes que tengan sus llaves. La que no las tenga se salta.
# Ninguna es obligatoria: el sitio y el robot funcionan igual sin una sola de estas.
#
# Telegram: se crea un bot hablando con @BotFather, se le pone de administrador del canal y ya.
# El chat es «@nombredelcanal» si es público, o el número (negativo) si es privado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bluesky: el usuario (losupe.bsky.social) y una CONTRASEÑA DE APLICACIÓN — Ajustes → Privacidad
# y seguridad → Contraseñas de aplicación. No es la contraseña de la cuenta y se puede anular sola.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Solo si la cuenta no está en bsky.social. Por defecto ya apunta ahí.
BLUESKY_HOST=
# Mastodon: el servidor donde está la cuenta y su llave (Preferencias → Desarrollo → Nueva
# aplicación, con permiso de escritura).
MASTODON_HOST=
MASTODON_TOKEN=
# Facebook: el id de la PÁGINA (no del perfil) y un token de página de larga duración. Es la única
# que exige pasar por la revisión de Meta (permiso pages_manage_posts).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
