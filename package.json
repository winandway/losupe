{
  "name": "losupe",
  "version": "0.1.0",
  "private": true,
  "description": "losupe.com — portal de noticias bilingüe (ES/EN) con robot redactor propio. Publicado en YaDominios Cloud.",
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=high && { npm audit --audit-level=high || true; }",
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "npm run schema:embed && opennextjs-cloudflare build",
    "db:local": "bash scripts/db-local.sh",
    "dev": "next dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "import:mundoscrypto": "tsx scripts/import-mundoscrypto.ts",
    "lint": "eslint .",
    "miniaturas": "node scripts/generar-miniaturas.mjs",
    "prepare": "husky",
    "preview": "npm run schema:embed && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "schema:embed": "node scripts/embed-schema.mjs",
    "secrets": "gitleaks detect --source . --no-banner --redact",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run schema:embed && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run audit && npm run secrets"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
